# Copy to .env and fill in real values.
# main.py auto-downloads Whisper + Ollama models from these settings.

DB_HOST=localhost
DB_NAME=your_db
DB_USER=your_user
DB_PASS=your_password
DB_PORT=5432

# Whisper (downloaded automatically on first run — no HF token required)
# distil-large-v3 ≈ large quality, faster than full large-v3
WHISPER_MODEL=distil-large-v3
WHISPER_DEVICE=auto
WHISPER_BEAM_SIZE=5
CALL_LANGUAGE=auto
WHISPER_TASK=auto

# true = write full transcript files under logs/transcripts/
LOG_FULL_TRANSCRIPT=true

# Ollama chat model — pulled automatically if missing.
# Prefer a real Ollama tag, e.g. llama3.1:8b (not a made-up -instruct suffix).
OLLAMA_LOCAL_MODEL=llama3.1:8b

CLOUD_BASE_URL=https://your-bucket.s3.amazonaws.com

DOWNLOAD_TIMEOUT=60
MAX_FILE_MB=50
IDLE_SLEEP_SECONDS=60
BATCH_SIZE=50

# false = only unprocessed (aiSummary IS NULL)
# true  = process all recordings with a URL (re-analyze / overwrite)
PROCESS_ALL_RECORDINGS=false

# Local Xtended Space knowledge / BM25 (offline; rebuild via scripts/build_knowledge_index.py)
KNOWLEDGE_ENABLED=true
KNOWLEDGE_DIR=knowledge
KNOWLEDGE_INDEX_DIR=.knowledge_index
KNOWLEDGE_TOP_K=4
